---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.jsx";
import GradualBlur from "../components/GradualBlur.jsx";
import Hero from "../components/Hero.jsx";
import Clients from "../components/Clients.jsx";
import About from "../components/About.jsx";
import Services from "../components/Services.jsx";
import Projects from "../components/Projects.astro";
import HowIWork from "../components/HowIWork.jsx";
import Contact from "../components/Contact.jsx";
---

<Layout
  title="Youssef Kader - Digital Product Designer & Developer"
  description="Helping agencies and founders launch websites, apps, and brands - from strategy to design to development."
>
  <!-- Navigation -->
  <Nav client:load />

  <main>
    <Hero client:load />
    <Clients client:visible />
    <About client:load />
    <Services client:load />
    <HowIWork client:load />
    <Projects />
    <Contact client:load />
  </main>

  <GradualBlur
    client:load
    target="page"
    position="bottom"
    height="3.5rem"
    strength={1.15}
    divCount={4}
    curve="bezier"
    exponential
    opacity={0.45}
    zIndex={5}
    className="site-bottom-fade"
  />
</Layout>
