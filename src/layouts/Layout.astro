---
import "../styles/global.css";
import SiteCursor from "../components/ui/SiteCursor";

const {
  title = "Youssef Kader - Digital Product Designer & Developer",
  description = "Helping agencies and founders launch websites, apps, and brands - from strategy to design to development.",
  bodyClass = "",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/bsx0nwx.css" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <SiteCursor client:load />
    <div class="cv-info-edge" aria-label="CV information">CV info</div>
    <slot />
  </body>
</html>

<style>
  .cv-info-edge {
    position: fixed;
    top: 50%;
    right: -26px;
    z-index: 1200;
    display: flex;
    width: 84px;
    height: 32px;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%) rotate(-90deg);
    background: #fff;
    color: #0a0a0a;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
</style>
