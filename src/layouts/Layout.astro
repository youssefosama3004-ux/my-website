---
import "../styles/global.css";
import SiteCursor from "../components/ui/SiteCursor";

const {
  title = "Youssef Kader - Digital Product Designer & Developer",
  description = "Helping agencies and founders launch websites, apps, and brands - from strategy to design to development.",
  bodyClass = "",
  showCvInfo = true,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/bsx0nwx.css" />
    <meta name="theme-color" content="#0A0A0A" />
    <script is:inline>
      (() => {
        const key = "youssef-kader-theme";
        let savedTheme = null;

        try {
          savedTheme = window.localStorage.getItem(key);
        } catch {}

        const theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
        const root = document.documentElement;

        root.dataset.theme = theme;
        root.classList.toggle("dark", theme === "dark");
        root.classList.toggle("light", theme === "light");
        root.style.colorScheme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#0A0A0A" : "#F7F7F5");
      })();
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <SiteCursor client:load />
    {showCvInfo && (
      <a
        class="cv-info-edge"
        href="/quick-info"
        aria-label="Open quick resume information"
      >
        Quick info
      </a>
    )}
    <slot />
  </body>
</html>

<style>
  .cv-info-edge {
    position: fixed;
    top: 50%;
    right: -26px;
    z-index: 1200;
    display: flex;
    width: 84px;
    height: 32px;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%) rotate(-90deg);
    background: #fff;
    color: #0a0a0a;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    cursor: pointer;
    pointer-events: auto !important;
    text-decoration: none;
    user-select: none;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .cv-info-edge:hover {
    background: var(--color-blue-500);
    color: #fff;
    transform: translateY(-50%) rotate(-90deg) translateY(-2px);
  }

  .cv-info-edge:focus-visible {
    outline: 2px solid var(--color-blue-500);
    outline-offset: 3px;
  }
</style>
