---
import "../styles/global.css";
import { GravityStarsBackground } from "../components/ui/GravityStarsBackground";
import SiteCursor from "../components/ui/SiteCursor";

const {
  title = "Youssef Kader - Digital Product Designer & Developer",
  description = "Helping agencies and founders launch websites, apps, and brands - from strategy to design to development.",
  bodyClass = "",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/bsx0nwx.css" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <GravityStarsBackground
      client:load
      starsCount={30}
      starsSize={1.35}
      starsOpacity={0.32}
      glowIntensity={8}
      movementSpeed={0.12}
      mouseInfluence={130}
      gravityStrength={42}
      className="site-gravity-stars"
    />
    <SiteCursor client:load />
    <slot />
  </body>
</html>
